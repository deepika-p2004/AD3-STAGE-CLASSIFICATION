      "source": [
        "## FIX 6 — Temperature Scaling (Pooled Out-of-Fold Calibration)\n",
        "Reloads each fold's *best* checkpoint and evaluates it on that fold's own validation\n",
        "indices, so every one of the 138 scans gets exactly one true out-of-fold prediction\n",
        "(no scan is ever scored by a model that trained on it). Temperature `T` is fit on this\n",
        "pooled set (~138 samples) rather than a single fold's ~28-sample validation set, which\n",
        "is far less sensitive to 1-2 unlucky misclassifications swinging the estimate.\n",
        "\n",
        "`T` is only applied downstream if it actually *improves* pooled ECE — otherwise\n",
        "`T_final = 1.0` (no scaling) is used everywhere else in the notebook.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "SAzLSMjjLwWG",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "5a8032d5-e2e9-4dc7-b153-446df1de0ada"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Pooled OOF predictions: 88 samples across 5 folds\n",
            "\n",
            "Fitted temperature (pooled OOF, n=88): 1.446\n",
            "--- Pooled OOF — Before scaling (T=1.0) ---\n",
            "  [0.3-0.4]  n= 21  acc=0.667  avg_conf=0.383\n",
            "  [0.4-0.5]  n= 35  acc=0.686  avg_conf=0.436\n",
            "  [0.5-0.6]  n= 14  acc=1.000  avg_conf=0.553\n",
            "  [0.6-0.7]  n=  7  acc=0.857  avg_conf=0.640\n",
            "  [0.7-0.8]  n=  5  acc=1.000  avg_conf=0.735\n",
            "  [0.8-0.9]  n=  1  acc=1.000  avg_conf=0.878\n",
            "  [0.9-1.0]  n=  5  acc=1.000  avg_conf=0.957\n",
            "ECE: 0.2741\n",
            "\n",
            "--- Pooled OOF — After scaling (T=1.446) ---\n",
            "  [0.3-0.4]  n= 38  acc=0.632  avg_conf=0.377\n",
            "  [0.4-0.5]  n= 27  acc=0.852  avg_conf=0.437\n",
            "  [0.5-0.6]  n= 12  acc=0.917  avg_conf=0.535\n",
            "  [0.6-0.7]  n=  5  acc=1.000  avg_conf=0.626\n",
            "  [0.7-0.8]  n=  1  acc=1.000  avg_conf=0.764\n",
            "  [0.8-0.9]  n=  5  acc=1.000  avg_conf=0.874\n",
            "ECE: 0.3203\n",
            "\n",
            "Temperature scaling does NOT improve pooled calibration (0.2741 -> 0.3203). Keeping T_final=1.0 (no scaling).\n"
          ]
        }
      ],
      "source": [
        "# ─── FIX 6: Temperature Scaling — fit on pooled out-of-fold predictions ──\n",
        "class TemperatureScaler(nn.Module):\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "        self.temperature = nn.Parameter(torch.ones(1) * 1.5)\n",
        "\n",
        "    def forward(self, logits):\n",
        "        return logits / self.temperature\n",
        "\n",
        "\n",
        "def fit_temperature_from_logits(logits, labels):\n",
        "    scaler = TemperatureScaler()\n",
        "    optimizer = torch.optim.LBFGS([scaler.temperature], lr=0.01, max_iter=50)\n",
        "    nll = nn.CrossEntropyLoss()\n",
        "\n",
        "    def closure():\n",
        "        optimizer.zero_grad()\n",
        "        loss = nll(scaler(logits), labels)\n",
        "        loss.backward()\n",
        "        return loss\n",
        "\n",
        "    optimizer.step(closure)\n",
        "    print(f'Fitted temperature (pooled OOF, n={len(labels)}): {scaler.temperature.item():.3f}')\n",
        "    return scaler.temperature.item()\n",
        "\n",
        "\n",
        "def compute_ece(df, n_bins=10, label=''):\n",
        "    bins = np.linspace(0, 1, n_bins + 1)\n",
        "    ece = 0.0\n",
        "    correct = (df['true_label'] == df['pred_label']).values\n",
        "    conf = df['confidence'].values\n",
        "    print(f'--- {label} ---')\n",
        "    for i in range(n_bins):\n",
        "        lo, hi = bins[i], bins[i+1]\n",
        "        mask = (conf > lo) & (conf <= hi)\n",
        "        if mask.sum() == 0: continue\n",
        "        bin_acc  = correct[mask].mean()\n",
        "        bin_conf = conf[mask].mean()\n",
        "        ece += (mask.sum() / len(df)) * abs(bin_acc - bin_conf)\n",
        "        print(f'  [{lo:.1f}-{hi:.1f}]  n={mask.sum():3d}  acc={bin_acc:.3f}  avg_conf={bin_conf:.3f}')\n",
        "    print(f'ECE: {ece:.4f}\\n')\n",
        "    return ece\n",
        "\n",
        "\n",
        "def logits_to_df(logits, labels, T=1.0):\n",
        "    probs = F.softmax(logits / T, dim=1)\n",
        "    preds = probs.argmax(dim=1)\n",
        "    conf  = probs.max(dim=1).values\n",
        "    return pd.DataFrame({\n",
        "        'true_label': labels.numpy(),\n",
        "        'pred_label': preds.numpy(),\n",
        "        'confidence': conf.numpy(),\n",
        "    })\n",
        "\n",
        "\n",
        "# ── Build pooled out-of-fold logits: each fold's BEST checkpoint scored\n",
        "#    only on that fold's own (held-out) validation indices ──────────────\n",
        "oof_logits, oof_labels = [], []\n",
        "for fr in fold_results:\n",
        "    f = fr['fold']\n",
        "    val_idx = fr['val_idx']\n",
        "    m = ADModel_M5().to(device)\n",
        "    m.load_state_dict(torch.load(f'/content/AD_model_fold{f}.pth', map_location=device))\n",
        "    m.eval()\n",
        "    loader = DataLoader(Subset(full_dataset, val_idx), batch_size=4, shuffle=False, num_workers=0)\n",
        "    with torch.no_grad():\n",
        "        for mri, hippo, tabular, labels in loader:\n",
        "            mri, hippo, tabular = mri.to(device), hippo.to(device), tabular.to(device)\n",
        "            _, _, cls_logits = m(mri, hippo, tabular)\n",
        "            oof_logits.append(torch.nan_to_num(cls_logits).cpu())\n",
        "            oof_labels.append(labels.clamp(max=2))\n",
        "\n",
        "oof_logits = torch.cat(oof_logits)\n",
        "oof_labels = torch.cat(oof_labels)\n",
        "print(f'Pooled OOF predictions: {len(oof_labels)} samples across {len(fold_results)} folds\\n')\n",
        "\n",
        "# ── Fit T on the pooled set, then only keep it if it actually helps ─────\n",
        "oof_before = logits_to_df(oof_logits, oof_labels, T=1.0)\n",
        "T = fit_temperature_from_logits(oof_logits, oof_labels)\n",
        "oof_after = logits_to_df(oof_logits, oof_labels, T=T)\n",
        "\n",
        "ece_before_oof = compute_ece(oof_before, label='Pooled OOF — Before scaling (T=1.0)')\n",
        "ece_after_oof  = compute_ece(oof_after,  label=f'Pooled OOF — After scaling (T={T:.3f})')\n",
        "\n",
        "if ece_after_oof < ece_before_oof:\n",
        "    print(f'Temperature scaling improves pooled calibration '\n",
        "          f'({ece_before_oof:.4f} -> {ece_after_oof:.4f}). Using T_final={T:.3f}.')\n",
        "    T_final = T\n",
        "else:\n",
        "    print(f'Temperature scaling does NOT improve pooled calibration '\n",
        "          f'({ece_before_oof:.4f} -> {ece_after_oof:.4f}). Keeping T_final=1.0 (no scaling).')\n",
        "    T_final = 1.0\n"
      ]
    },
