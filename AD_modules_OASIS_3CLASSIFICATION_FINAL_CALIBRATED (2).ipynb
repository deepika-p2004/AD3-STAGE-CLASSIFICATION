      "source": [
        "# ═══════════════════════════════════════════════════════════════════════\n",
        "# MODULE 6 — Feature Fusion and Classification\n",
        "#   Input : shared_feat (Module 3) -> local_feat (Module 4a) +\n",
        "#           global_feat (Module 4b) -> AttentionFusion (Module 5) ->\n",
        "#           concat with tabular -> dense layers -> softmax\n",
        "#   Output: fused feature vectors, probability distributions,\n",
        "#           classification outputs (Normal / Very Mild / Mild)\n",
        "# ═══════════════════════════════════════════════════════════════════════\n",
        "\n",
        "model.load_state_dict(torch.load('/content/AD_model_m5_best.pth', map_location=device))\n",
        "model.eval()\n",
        "\n",
        "CLASS_NAMES = {0: 'Normal (CDR 0)', 1: 'Very Mild (CDR 0.5)', 2: 'Mild (CDR 1)'}\n",
        "\n",
        "\n",
        "@torch.no_grad()\n",
        "def classify_batch(mri, hippo, tabular):\n",
        "    \"\"\"Original (unscaled) confidence — kept for before/after comparison.\"\"\"\n",
        "    mri, hippo, tabular = mri.to(device), hippo.to(device), tabular.to(device)\n",
        "    fused, seg_logits, cls_logits = model(mri, hippo, tabular)\n",
        "    cls_logits = torch.nan_to_num(cls_logits)\n",
        "    probs = F.softmax(cls_logits, dim=1)\n",
        "    pred_labels = probs.argmax(dim=1)\n",
        "    confidence = probs.max(dim=1).values\n",
        "    return fused.cpu(), probs.cpu(), pred_labels.cpu(), confidence.cpu()\n",
        "\n",
        "\n",
        "@torch.no_grad()\n",
        "def classify_batch_scaled(mri, hippo, tabular):\n",
        "    \"\"\"Temperature-scaled confidence.\"\"\"\n",
        "    mri, hippo, tabular = mri.to(device), hippo.to(device), tabular.to(device)\n",
        "    fused, seg_logits, cls_logits = model(mri, hippo, tabular)\n",
        "    cls_logits = torch.nan_to_num(cls_logits) / T\n",
        "    probs = F.softmax(cls_logits, dim=1)\n",
        "    pred_labels = probs.argmax(dim=1)\n",
        "    confidence = probs.max(dim=1).values\n",
        "    return fused.cpu(), probs.cpu(), pred_labels.cpu(), confidence.cpu()\n",
        "\n",
        "\n",
        "def classify_dataset(loader, fn=classify_batch):\n",
        "    \"\"\"Runs Module 6 over a full DataLoader and returns a results table.\"\"\"\n",
        "    records = []\n",
        "    for mri, hippo, tabular, labels in loader:\n",
        "        fused, probs, preds, conf = fn(mri, hippo, tabular)\n",
        "        true = labels.clamp(max=2)\n",
        "        for i in range(len(preds)):\n",
        "            records.append({\n",
        "                'true_label':     int(true[i]),\n",
        "                'pred_label':     int(preds[i]),\n",
        "                'confidence':     float(conf[i]),\n",
        "                'prob_normal':    float(probs[i, 0]),\n",
        "                'prob_very_mild': float(probs[i, 1]),\n",
        "                'prob_mild':      float(probs[i, 2]),\n",
        "                'fused_vector':   fused[i].numpy(),\n",
        "            })\n",
        "    return pd.DataFrame(records)\n",
        "\n",
        "\n",
        "results_df     = classify_dataset(best_val_loader, fn=classify_batch)\n",
        "results_scaled = classify_dataset(best_val_loader, fn=classify_batch_scaled)\n",
        "\n",
        "print(f'Module 6 — classified {len(results_df)} samples (best-fold val set)')\n",
        "results_df[['true_label', 'pred_label', 'confidence',\n",
        "            'prob_normal', 'prob_very_mild', 'prob_mild']].head(10)\n"
      ]
    },
