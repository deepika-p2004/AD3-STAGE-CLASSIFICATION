        "print(f'MSD → Train:{n_train}  Val:{n_val}  Test:{n_test}')\n",
        "img, lab = train_msd[0]\n",
        "print(f'Image:{img.shape}  Label classes:{torch.unique(lab).tolist()}')"
      ]
