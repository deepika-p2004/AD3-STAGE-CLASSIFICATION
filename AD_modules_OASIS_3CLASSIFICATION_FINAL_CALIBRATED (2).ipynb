      "source": [
        "model.load_state_dict(torch.load('/content/AD_model_m5_best.pth', map_location=device))\n",
        "model.eval()\n",
        "\n",
        "# Use best fold's val set for all downstream evaluation (FIX 1 + 4)\n",
        "best_val_loader = DataLoader(\n",
        "    Subset(full_dataset, best_fold_val_idx),\n",
        "    batch_size=4, shuffle=False, num_workers=0)\n",
        "\n",
        "all_feats, all_labels = [], []\n",
        "with torch.no_grad():\n",
        "    for mri, hippo, tabular, labels in best_val_loader:\n",
        "        fused, _, _ = model(mri.to(device), hippo.to(device), tabular.to(device))\n",
        "        fused       = torch.nan_to_num(fused)\n",
        "        all_feats.append(fused.cpu())\n",
        "        all_labels.extend(labels.tolist())\n",
        "\n",
        "all_feats  = torch.cat(all_feats).numpy()\n",
        "all_labels = np.array([min(l, 2) for l in all_labels])\n",
        "mask       = ~np.isnan(all_feats).any(axis=1)\n",
        "all_feats, all_labels = all_feats[mask], all_labels[mask]\n",
