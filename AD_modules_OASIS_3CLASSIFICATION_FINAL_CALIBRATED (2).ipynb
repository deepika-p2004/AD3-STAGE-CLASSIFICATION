7747478485,\n          0.41985419392585754\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"prob_mild\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.41229344777620897,\n        \"min\": 0.04530211165547371,\n        \"max\": 0.9581411480903625,\n        \"num_unique_values\": 10,\n        \"samples\": [\n          0.048291921615600586,\n          0.06795874238014221\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
