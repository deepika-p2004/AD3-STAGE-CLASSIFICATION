      "source": [
        "SEG_EPOCHS    = 20\n",
        "seg_history   = {'train_loss':[], 'train_dice':[], 'val_loss':[], 'val_dice':[]}\n",
        "best_seg_dice = 0.0\n",
        "\n",
        "print(f\"{'Epoch':>6}  {'TrLoss':>8}  {'TrDice':>8}  {'VlLoss':>8}  {'VlDice':>8}\")\n",
        "print('─'*50)\n",
        "\n",
        "for epoch in range(SEG_EPOCHS):\n",
        "    seg_model.train(); t_loss=t_dice=0\n",
        "    for imgs, labs in msd_loader:\n",
        "        imgs, labs = imgs.to(device), labs.to(device)\n",
        "        seg_opt.zero_grad()\n",
        "        logits = seg_model(imgs)\n",
        "        loss   = ce_loss(logits, labs) + dice_loss(logits, labs)\n",
        "        loss.backward()\n",
        "        torch.nn.utils.clip_grad_norm_(seg_model.parameters(), 1.0)\n",
        "        seg_opt.step()\n",
        "        t_loss += loss.item()\n",
        "        t_dice += dice_score(torch.argmax(logits,dim=1), labs)\n",
        "\n",
        "    seg_model.eval(); v_loss=v_dice=0\n",
        "    with torch.no_grad():\n",
        "        for imgs, labs in msd_val_loader:\n",
        "            imgs, labs = imgs.to(device), labs.to(device)\n",
        "            logits = seg_model(imgs)\n",
        "            loss   = ce_loss(logits, labs) + dice_loss(logits, labs)\n",
        "            v_loss += loss.item()\n",
        "            v_dice += dice_score(torch.argmax(logits,dim=1), labs)\n",
        "\n",
        "    scheduler.step()\n",
        "    nt, nv = len(msd_loader), len(msd_val_loader)\n",
        "    seg_history['train_loss'].append(t_loss/nt)\n",
        "    seg_history['train_dice'].append(t_dice/nt)\n",
        "    seg_history['val_loss'].append(v_loss/nv)\n",
        "    seg_history['val_dice'].append(v_dice/nv)\n",
        "\n",
        "    flag = ' ✔' if v_dice/nv > best_seg_dice else ''\n",
        "    if v_dice/nv > best_seg_dice:\n",
        "        best_seg_dice = v_dice/nv\n",
        "        torch.save(seg_model.state_dict(), '/content/hippocampus_unet.pth')\n",
        "    print(f\"{epoch+1:>6}  {t_loss/nt:>8.4f}  {t_dice/nt:>8.4f}  {v_loss/nv:>8.4f}  {v_dice/nv:>8.4f}{flag}\")\n",
        "\n",
        "print(f'\\n✔ Best Val Dice: {best_seg_dice:.4f}  →  /content/hippocampus_unet.pth')"
      ]
