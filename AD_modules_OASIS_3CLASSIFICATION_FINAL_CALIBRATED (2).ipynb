      "source": [
        "class MSDDataset(Dataset):\n",
        "    \"\"\"\n",
        "    Module 1: Loads MSD Task04 Hippocampus NIfTI scans.\n",
        "    Module 2: Z-score normalisation + resize to 64³.\n",
        "    Labels: 0=background, 1=anterior hippo, 2=posterior hippo.\n",
        "    \"\"\"\n",
        "    def __init__(self, img_dir, label_dir, target_size=(64,64,64)):\n",
        "        self.target_size = target_size\n",
        "        self.img_dir     = img_dir\n",
        "        self.label_dir   = label_dir\n",
        "        self.images = sorted([f for f in os.listdir(img_dir)\n",
        "                               if f.endswith('.nii.gz') and not f.startswith('._')])\n",
        "        print(f'MSD dataset: {len(self.images)} samples found.')\n",
        "\n",
        "    def __len__(self): return len(self.images)\n",
        "\n",
        "    def __getitem__(self, idx):\n",
        "        img = nib.load(os.path.join(self.img_dir,   self.images[idx])).get_fdata()\n",
        "        lab = nib.load(os.path.join(self.label_dir, self.images[idx])).get_fdata()\n",
        "        img = (img - img.mean()) / (img.std() + 1e-8)\n",
        "        img = torch.tensor(img, dtype=torch.float32).unsqueeze(0)\n",
        "        lab = torch.tensor(lab, dtype=torch.long)\n",
        "        img = F.interpolate(img.unsqueeze(0), size=self.target_size,\n",
        "                            mode='trilinear', align_corners=False).squeeze(0)\n",
        "        lab = F.interpolate(lab.float().unsqueeze(0).unsqueeze(0),\n",
        "                            size=self.target_size,\n",
        "                            mode='nearest').squeeze(0).squeeze(0).long()\n",
        "        return img, lab"
      ]
    },
