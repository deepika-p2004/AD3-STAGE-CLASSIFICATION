        "## Module 3 — Shared 3D CNN Encoder"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "0LHd81aPVd2T"
      },
      "source": [
        "## Module 3 — Shared 3D CNN Encoder (FIX 3: Reduced Complexity, Higher Dropout)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "vgJYo4y8Vd2T",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "6f8a88bd-ae6b-41b9-8b30-1ae82b798d1a"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Encoder output: torch.Size([1, 96, 8, 8, 8])\n",
            "Encoder params: 146,064  (smaller = less overfit)\n"
          ]
        }
      ],
      "source": [
        "class Encoder(nn.Module):\n",
        "    def __init__(self, dropout=0.45, in_channels=1):   # add in_channels param\n",
        "        super().__init__()\n",
        "        self.block1 = nn.Sequential(\n",
        "            nn.Conv3d(in_channels, 16, 3, padding=1), nn.BatchNorm3d(16),\n",
        "            nn.ReLU(inplace=True), nn.Dropout3d(dropout))\n",
        "        self.block2 = nn.Sequential(\n",
        "            nn.Conv3d(16, 48, 3, padding=1), nn.BatchNorm3d(48),  # FIX 3: 64->48\n",
        "            nn.ReLU(inplace=True), nn.Dropout3d(dropout))\n",
        "        self.block3 = nn.Sequential(\n",
        "            nn.Conv3d(48, 96, 3, padding=1), nn.BatchNorm3d(96),  # FIX 3: 128->96\n",
        "            nn.ReLU(inplace=True))\n",
        "        self.pool = nn.MaxPool3d(2)\n",
        "\n",
        "    def forward(self, x):\n",
        "        x = self.pool(self.block1(x))   # [B,  16, 32, 32, 32]\n",
        "        x = self.pool(self.block2(x))   # [B,  48, 16, 16, 16]\n",
        "        x = self.pool(self.block3(x))   # [B,  96,  8,  8,  8]\n",
        "        return x\n",
        "\n",
        "_enc = Encoder().to(device)\n",
        "_x   = torch.zeros(1,1,64,64,64).to(device)\n",
        "out  = _enc(_x)\n",
        "print(f'Encoder output: {out.shape}')  # [1,96,8,8,8]\n",
        "print(f'Encoder params: {sum(p.numel() for p in _enc.parameters()):,}  (smaller = less overfit)')\n",
        "del _enc, _x, out\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "-2zJoCdyVd2T"
      },
      "source": [
        "## Module 4b — Cross-Scale Swin Transformer (REAL window-based attention)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "YBYA_RZLVd2T",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "79039914-b978-4bc7-a66e-8953397876b8"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "CrossScaleSwinTransformer3D output: torch.Size([2, 96])\n"
          ]
        }
      ],
      "source": [
        "class PatchEmbed3D(nn.Module):\n",
        "    def __init__(self, window_size=2):\n",
        "        super().__init__()\n",
        "        self.ws = window_size\n",
        "\n",
        "    def forward(self, x):\n",
        "        B, C, D, H, W = x.shape\n",
        "        ws = self.ws\n",
        "        x = x.view(B, C, D//ws, ws, H//ws, ws, W//ws, ws)\n",
        "        x = x.permute(0, 2, 4, 6, 3, 5, 7, 1)\n",
        "        nD, nH, nW = D//ws, H//ws, W//ws\n",
        "        x = x.reshape(B*nD*nH*nW, ws*ws*ws, C)\n",
        "        return x, (B, nD, nH, nW)\n",
        "\n",
        "\n",
        "class SwinBlock3D(nn.Module):\n",
        "    def __init__(self, dim=96, num_heads=4, mlp_ratio=2.0, dropout=0.45):  # FIX 3: mlp_ratio 4->2\n",
        "        super().__init__()\n",
        "        self.norm1  = nn.LayerNorm(dim)\n",
        "        self.norm2  = nn.LayerNorm(dim)\n",
        "        self.w_attn = nn.MultiheadAttention(dim, num_heads, dropout=dropout, batch_first=True)\n",
        "        mlp_dim     = int(dim * mlp_ratio)\n",
        "        self.ffn    = nn.Sequential(\n",
        "            nn.Linear(dim, mlp_dim), nn.GELU(), nn.Dropout(dropout),\n",
        "            nn.Linear(mlp_dim, dim), nn.Dropout(dropout))\n",
        "\n",
        "    def forward(self, x):\n",
        "        n = self.norm1(x)\n",
        "        a, _ = self.w_attn(n, n, n)\n",
        "        x = x + a\n",
        "        x = x + self.ffn(self.norm2(x))\n",
        "        return x\n",
        "\n",
        "\n",
        "class CrossScaleSwinTransformer3D(nn.Module):\n",
        "    \"\"\"FIX 3: dim reduced to 96 to match smaller Encoder output channels.\"\"\"\n",
        "    def __init__(self, in_channels=96, dim=96, num_heads=4, dropout=0.45):\n",
        "        super().__init__()\n",
        "        self.proj         = nn.Conv3d(in_channels, dim, 1)\n",
        "        self.patch_fine   = PatchEmbed3D(window_size=2)\n",
        "        self.swin_fine    = nn.ModuleList([SwinBlock3D(dim, num_heads, dropout=dropout) for _ in range(2)])\n",
        "        self.patch_coarse = PatchEmbed3D(window_size=4)\n",
        "        self.swin_coarse  = nn.ModuleList([SwinBlock3D(dim, num_heads, dropout=dropout) for _ in range(2)])\n",
        "        self.cross_attn   = nn.MultiheadAttention(dim, num_heads, dropout=dropout, batch_first=True)\n",
        "        self.cross_norm   = nn.LayerNorm(dim)\n",
        "        self.out_norm     = nn.LayerNorm(dim)\n",
        "        self.out_proj     = nn.Linear(dim, dim)\n",
        "\n",
        "    def forward(self, feat):\n",
        "        B = feat.size(0)\n",
        "        x = self.proj(feat)\n",
        "        fine_tokens, (_, nD, nH, nW) = self.patch_fine(x)\n",
        "        for blk in self.swin_fine:\n",
        "            fine_tokens = blk(fine_tokens)\n",
        "        fine_global = fine_tokens.mean(dim=1, keepdim=True).view(B, nD*nH*nW, -1)\n",
        "        coarse_tokens, (_, cD, cH, cW) = self.patch_coarse(x)\n",
        "        for blk in self.swin_coarse:\n",
        "            coarse_tokens = blk(coarse_tokens)\n",
        "        coarse_global = coarse_tokens.mean(dim=1).view(B, cD*cH*cW, -1)\n",
        "        cross_out, _ = self.cross_attn(fine_global, coarse_global, coarse_global)\n",
        "        fused = self.cross_norm(fine_global + cross_out)\n",
        "        global_ctx = self.out_norm(fused).mean(dim=1)\n",
        "        return self.out_proj(global_ctx)\n",
        "\n",
        "_tr  = CrossScaleSwinTransformer3D().to(device)\n",
        "_x   = torch.zeros(2, 96, 8, 8, 8).to(device)\n",
        "_out = _tr(_x)\n",
        "print(f'CrossScaleSwinTransformer3D output: {_out.shape}')  # [2, 96]\n",
        "del _tr, _x, _out\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "im2zRFu4Vd2U"
      },
      "source": [
        "## Module 5 — Attention Fusion"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "w2vY6-FBVd2U"
      },
      "outputs": [],
      "source": [
        "class AttentionFusion(nn.Module):\n",
        "    \"\"\"FIX 3: dim=96 to match reduced encoder.\"\"\"\n",
        "    def __init__(self, dim=96):  # was 128\n",
        "        super().__init__()\n",
        "        self.gate = nn.Sequential(\n",
        "            nn.Linear(dim*2, dim), nn.ReLU(inplace=True),\n",
        "            nn.Linear(dim, dim),   nn.Sigmoid())\n",
        "\n",
        "    def forward(self, global_feat, local_feat):\n",
        "        g = self.gate(torch.cat([global_feat, local_feat], dim=1))\n",
        "        return g * global_feat + (1-g) * local_feat\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "4ZJsRHysVd2U"
      },
      "source": [
        "## Full Model — ADModel_M5 (FIX 3: Reduced Complexity + Higher Dropout)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "vkv0bi-IVd2U",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "6fecf253-8f87-4ab9-ca94-ae25786bc18d"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "ADModel_M5 total params: 605,718\n",
            "  Encoder      : 146,496\n",
            "  Seg Decoder  : 48,675\n",
            "  Swin (M4b)   : 355,392\n",
            "  Fusion (M5)  : 27,840\n",
            "  Tab Encoder  : 1,392\n",
            "  Classifier   : 7,395\n",
            "Fused:torch.Size([2, 96]) | Seg:torch.Size([2, 3, 64, 64, 64]) | Cls:torch.Size([2, 3])\n"
          ]
        }
      ],
      "source": [
        "class ADModel_M5(nn.Module):\n",
        "    \"\"\"\n",
        "    FIX 3: Reduced complexity throughout:\n",
        "      - Encoder: 16→48→96 filters (was 32→64→128)\n",
        "      - Dropout: 0.45 (was 0.1/0.3)\n",
        "      - Classifier: 192→64→3 (unchanged)\n",
        "      - mlp_ratio in Swin: 2.0 (was 4.0)\n",
        "    \"\"\"\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "        DROPOUT = 0.45  # FIX 3: centralised dropout constant\n",
        "        self.shared_encoder = Encoder(dropout=DROPOUT, in_channels=2)\n",
        "        self.seg_decoder = nn.Sequential(\n",
        "            nn.ConvTranspose3d(96, 48, 2, stride=2),\n",
        "            nn.BatchNorm3d(48), nn.ReLU(inplace=True),\n",
        "            nn.ConvTranspose3d(48, 24, 2, stride=2),\n",
        "            nn.BatchNorm3d(24), nn.ReLU(inplace=True),\n",
        "            nn.ConvTranspose3d(24, 12, 2, stride=2),\n",
        "            nn.BatchNorm3d(12), nn.ReLU(inplace=True),\n",
        "            nn.Conv3d(12, 3, 1))\n",
        "        self.seg_pool = nn.Sequential(\n",
        "            nn.AdaptiveAvgPool3d((4,4,4)),\n",
        "            nn.Flatten(),\n",
        "            nn.Linear(3*4*4*4, 96),\n",
        "            nn.ReLU(inplace=True))\n",
        "        self.swin_transformer = CrossScaleSwinTransformer3D(\n",
        "            in_channels=96, dim=96, num_heads=4, dropout=DROPOUT)\n",
        "        self.fusion = AttentionFusion(dim=96)\n",
        "        self.tab_encoder = nn.Sequential(\n",
        "            nn.Linear(7, 24), nn.ReLU(), nn.Dropout(DROPOUT),\n",
        "            nn.Linear(24, 48), nn.ReLU()\n",
        "        )\n",
        "        # Classifier: 96 (MRI) + 48 (tabular) = 144\n",
        "        self.classifier = nn.Sequential(\n",
        "            nn.LayerNorm(96 + 48),\n",
        "            nn.Linear(96 + 48, 48),\n",
        "            nn.GELU(),\n",
        "            nn.Dropout(DROPOUT),\n",
        "            nn.Linear(48, 3)\n",
        "        )\n",
        "\n",
        "    def forward(self, x, hippo, tabular):\n",
        "        x_in = torch.cat([x, hippo], dim=1)   # [B, 2, 64, 64, 64]\n",
        "        shared_feat = self.shared_encoder(x_in)        # [B, 96, 8, 8, 8]\n",
        "        seg_logits  = self.seg_decoder(shared_feat)   # [B, 3, 64, 64, 64]\n",
        "        local_feat  = self.seg_pool(seg_logits)       # [B, 96]\n",
        "        global_feat = self.swin_transformer(shared_feat)  # [B, 96]\n",
        "        fused       = self.fusion(global_feat, local_feat)  # [B, 96]\n",
        "        tab_feat    = self.tab_encoder(tabular)        # [B, 48]\n",
        "        fused_all   = torch.cat([fused, tab_feat], dim=1)   # [B, 144]\n",
        "        cls_logits  = self.classifier(fused_all)       # [B, 3]\n",
        "        return fused, seg_logits, cls_logits\n",
        "\n",
        "\n",
        "model = ADModel_M5().to(device)\n",
        "total = sum(p.numel() for p in model.parameters())\n",
        "print(f'ADModel_M5 total params: {total:,}')\n",
        "print(f'  Encoder      : {sum(p.numel() for p in model.shared_encoder.parameters()):,}')\n",
        "print(f'  Seg Decoder  : {sum(p.numel() for p in model.seg_decoder.parameters()):,}')\n",
        "print(f'  Swin (M4b)   : {sum(p.numel() for p in model.swin_transformer.parameters()):,}')\n",
        "print(f'  Fusion (M5)  : {sum(p.numel() for p in model.fusion.parameters()):,}')\n",
        "print(f'  Tab Encoder  : {sum(p.numel() for p in model.tab_encoder.parameters()):,}')\n",
        "print(f'  Classifier   : {sum(p.numel() for p in model.classifier.parameters()):,}')\n",
        "\n",
        "with torch.no_grad():\n",
        "    _x     = torch.zeros(2, 1, 64, 64, 64).to(device)\n",
        "    _hippo = torch.zeros(2, 1, 64, 64, 64).to(device)\n",
        "    _tab   = torch.zeros(2, 7).to(device)   # 6 -> 7, now that MMSE is added\n",
        "    _f, _s, _c = model(_x, _hippo, _tab)\n",
        "    print(f'Fused:{_f.shape} | Seg:{_s.shape} | Cls:{_c.shape}')\n",
        "del _x, _hippo, _tab, _f, _s, _c"
      ]
    },
    {
      "cell_type": "markdown",
