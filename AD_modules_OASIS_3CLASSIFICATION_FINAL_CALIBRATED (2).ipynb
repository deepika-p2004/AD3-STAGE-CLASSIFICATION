      "source": [
        "EPOCHS        = 40\n",
        "N_FOLDS       = 5\n",
        "PATIENCE      = 15    # early stopping patience\n",
        "USE_FOCAL     = True   # FIX 2: set False to use plain CrossEntropyLoss\n",
        "\n",
        "criterion = focal_criterion if USE_FOCAL else ce_criterion\n",
        "print(f'Loss: {\"FocalLoss\" if USE_FOCAL else \"CrossEntropyLoss\"}')\n",
        "\n",
        "# ─── FIX 1: Stratified split indices ────────────────────────────────────\n",
        "skf = StratifiedKFold(n_splits=N_FOLDS, shuffle=True, random_state=42)\n",
        "\n",
        "fold_results        = []\n",
        "best_global_acc     = 0.0\n",
        "best_fold_val_idx   = None   # tracked so final eval uses the best fold's val\n",
        "\n",
        "print(f'\\n{\"=\"*62}')\n",
        "print(f'FIX 4: {N_FOLDS}-Fold Stratified CV  |  {EPOCHS} max epochs  |  patience={PATIENCE}')\n",
        "print(f'{\"=\"*62}')\n",
        "\n",
        "for fold, (train_idx, val_idx) in enumerate(\n",
        "        skf.split(range(len(full_dataset)), labels_3cls)):\n",
        "\n",
        "    # Print class distribution for this fold\n",
        "    val_dist  = Counter([labels_3cls[i] for i in val_idx])\n",
        "    train_dist = Counter([labels_3cls[i] for i in train_idx])\n",
        "    print(f'\\n── Fold {fold+1}/{N_FOLDS}  train:{len(train_idx)}  val:{len(val_idx)}')\n",
        "    print(f'   Train dist: {dict(sorted(train_dist.items()))}')\n",
        "    print(f'   Val   dist: {dict(sorted(val_dist.items()))}')\n",
        "\n",
        "    # Re-init trainable heads each fold\n",
        "    def reset_heads(m):\n",
        "        if hasattr(m, 'reset_parameters'): m.reset_parameters()\n",
        "    model.classifier.apply(reset_heads)\n",
        "    model.tab_encoder.apply(reset_heads)\n",
        "\n",
        "    optimizer = torch.optim.AdamW(\n",
        "        filter(lambda p: p.requires_grad, model.parameters()),\n",
        "        lr=5e-4, weight_decay=1e-3)  # slightly lower LR than v3 for stability\n",
        "    sched = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=EPOCHS)\n",
        "\n",
        "    fold_train_loader = DataLoader(\n",
        "        Subset(full_dataset, train_idx), batch_size=4, shuffle=True,  num_workers=0)\n",
        "    fold_val_loader   = DataLoader(\n",
        "        Subset(full_dataset, val_idx),   batch_size=4, shuffle=False, num_workers=0)\n",
        "\n",
        "    history       = {'loss':[], 'acc':[], 'val_loss':[], 'val_acc':[]}\n",
        "    best_val_acc  = 0.0\n",
        "    patience_cnt  = 0\n",
        "\n",
        "    print(f\"  {'Ep':>4}  {'TrLoss':>8}  {'TrAcc':>7}  {'VlLoss':>8}  {'VlAcc':>7}\")\n",
        "    print('  ' + '-'*46)\n",
        "\n",
        "    for epoch in range(EPOCHS):\n",
        "        model.train()\n",
        "        t_loss = t_acc = n = 0\n",
        "\n",
        "        for mri, hippo, tabular, labels in fold_train_loader:\n",
        "            mri      = augment_batch(mri).to(device)\n",
        "            hippo    = hippo.to(device)          # add this\n",
        "            tabular  = tabular.to(device)\n",
        "            labels_3 = labels.clone().clamp(max=2).to(device)\n",
        "\n",
        "            optimizer.zero_grad()\n",
        "            fused, seg_logits, cls_logits = model(mri, hippo, tabular)   # pass hippo\n",
        "            cls_logits = torch.nan_to_num(cls_logits)\n",
        "\n",
        "            loss = criterion(cls_logits, labels_3)  # FIX 2: focal/class-weighted\n",
        "            if not torch.isfinite(loss): continue\n",
        "\n",
        "            loss.backward()\n",
        "            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n",
        "            optimizer.step()\n",
        "\n",
        "            preds   = cls_logits.argmax(dim=1)\n",
        "            t_loss += loss.item()\n",
        "            t_acc  += (preds == labels_3).float().mean().item()\n",
        "            n      += 1\n",
        "\n",
        "        model.eval()\n",
        "        v_loss = v_acc = m = 0\n",
        "        with torch.no_grad():\n",
        "            for mri, hippo, tabular, labels in fold_val_loader:\n",
        "                mri      = mri.to(device)\n",
        "                hippo    = hippo.to(device)          # add this\n",
        "                tabular  = tabular.to(device)\n",
        "                labels_3 = labels.clone().clamp(max=2).to(device)\n",
        "                fused, seg_logits, cls_logits = model(mri, hippo, tabular)   # pass hipp\n",
        "                loss    = criterion(cls_logits, labels_3)\n",
        "                preds   = cls_logits.argmax(dim=1)\n",
        "                v_loss += loss.item() if torch.isfinite(loss) else 0.0\n",
        "                v_acc  += (preds == labels_3).float().mean().item()\n",
        "                m      += 1\n",
        "\n",
        "        sched.step()\n",
        "        if n == 0: continue\n",
        "\n",
        "        tl = t_loss/n;  ta = t_acc/n\n",
        "        vl = v_loss/max(m,1); va = v_acc/max(m,1)\n",
        "        history['loss'].append(tl);      history['acc'].append(ta)\n",
        "        history['val_loss'].append(vl);  history['val_acc'].append(va)\n",
        "\n",
        "        # ── Early stopping + save best ───────────────────────────────────\n",
        "        flag = ''\n",
        "        if va > best_val_acc:\n",
        "            best_val_acc = va\n",
        "            patience_cnt = 0\n",
        "            flag = ' ✔'\n",
        "            torch.save(model.state_dict(), f'/content/AD_model_fold{fold+1}.pth')\n",
        "            if va > best_global_acc:\n",
        "                best_global_acc   = va\n",
        "                best_fold_val_idx = val_idx\n",
        "                torch.save(model.state_dict(), '/content/AD_model_m5_best.pth')\n",
        "        else:\n",
        "            patience_cnt += 1\n",
        "            if patience_cnt >= PATIENCE:\n",
        "                print(f'  Early stop at epoch {epoch+1}')\n",
        "                break\n",
        "\n",
        "        print(f'  {epoch+1:>4}  {tl:>8.4f}  {ta:>7.4f}  {vl:>8.4f}  {va:>7.4f}{flag}')\n",
        "\n",
        "    fold_results.append({'fold': fold+1, 'best_val_acc': best_val_acc,\n",
        "                          'history': history, 'val_idx': val_idx})\n",
        "    print(f'  Fold {fold+1} best val acc: {best_val_acc:.4f}')\n",
        "\n",
        "mean_acc = sum(r['best_val_acc'] for r in fold_results) / N_FOLDS\n",
        "print(f'\\n{\"=\"*62}')\n",
        "print(f'Mean CV Val Acc : {mean_acc:.4f}')\n",
        "print(f'Best global acc : {best_global_acc:.4f}')\n",
        "print(f'Best model saved -> /content/AD_model_m5_best.pth')\n"
      ]
    },
