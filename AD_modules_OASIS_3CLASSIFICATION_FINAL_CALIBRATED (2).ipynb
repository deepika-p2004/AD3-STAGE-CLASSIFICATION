      "source": [
        "class DiceLoss(nn.Module):\n",
        "    \"\"\"Soft Dice loss for 3D multi-class segmentation.\"\"\"\n",
        "    def __init__(self, num_classes=3, smooth=1e-5):\n",
        "        super().__init__()\n",
        "        self.num_classes = num_classes\n",
        "        self.smooth      = smooth\n",
        "\n",
        "    def forward(self, logits, targets):\n",
        "        probs          = F.softmax(logits, dim=1)\n",
        "        targets_onehot = F.one_hot(\n",
        "            targets.clamp(0, self.num_classes-1),\n",
        "            self.num_classes).permute(0,4,1,2,3).float()\n",
        "        dims  = (0,2,3,4)\n",
        "        inter = (probs * targets_onehot).sum(dim=dims)\n",
        "        union = probs.sum(dim=dims) + targets_onehot.sum(dim=dims)\n",
        "        dice  = (2*inter + self.smooth) / (union + self.smooth)\n",
        "        return 1 - dice.mean()\n",
        "\n",
        "\n",
        "def dice_score(pred, target):\n",
        "    \"\"\"Correct Dice — always in [0,1]. Guards zero denominator.\"\"\"\n",
        "    inter = ((pred > 0) & (target > 0)).sum().float()\n",
        "    denom = (pred > 0).sum().float() + (target > 0).sum().float()\n",
        "    if denom == 0:\n",
        "        return 1.0\n",
        "    return (2 * inter / denom).item()\n",
        "\n",
        "\n",
        "seg_model = UNet(\n",
        "    spatial_dims  = 3,\n",
        "    in_channels   = 1,\n",
        "    out_channels  = 3,\n",
        "    channels      = (16,32,64,128,256),\n",
        "    strides       = (2,2,2,2),\n",
        "    num_res_units = 2,\n",
        "    dropout       = 0.1,\n",
        ").to(device)\n",
        "\n",
        "ce_loss   = nn.CrossEntropyLoss()\n",
        "dice_loss = DiceLoss(num_classes=3)\n",
        "seg_opt   = torch.optim.AdamW(seg_model.parameters(), lr=2e-4, weight_decay=1e-5)\n",
        "scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(seg_opt, T_max=20)\n",
        "print(f'Seg model params: {sum(p.numel() for p in seg_model.parameters()):,}')"
      ]
    },
