      "source": [
        "## FIX 2 — Correct Class Weights via `compute_class_weight` + Focal Loss"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "tWZiEgobVd2V",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "9f7aba2c-2002-4205-d1a7-17095bcfe16d"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Class weights (balanced):\n",
            "  Class 0: n=36  weight=0.815\n",
            "  Class 1: n=17  weight=1.725\n",
            "  Class 2: n=35  weight=0.838\n",
            "Criteria ready: CrossEntropyLoss + FocalLoss (both with class weights)\n"
          ]
        }
      ],
      "source": [
        "# ─── FIX 2: Class Weights ──────────────────────────────────────────────\n",
        "# Merge label 3 (Moderate) into label 2 (Mild) since Moderate=0 samples\n",
        "labels_3cls = np.array([min(l, 2) for l in full_dataset.labels])\n",
        "\n",
        "unique_cls = np.unique(labels_3cls)\n",
        "cls_weights_np = compute_class_weight(\n",
        "    class_weight='balanced',\n",
        "    classes=unique_cls,\n",
        "    y=labels_3cls\n",
        ")\n",
        "# Pad to 3 classes (in case Mild has 0 samples in a fold)\n",
        "weights_m5 = torch.ones(3, dtype=torch.float32)\n",
        "for idx, cls in enumerate(unique_cls):\n",
        "    weights_m5[cls] = cls_weights_np[idx]\n",
        "weights_m5 = weights_m5.to(device)\n",
        "print('Class weights (balanced):')\n",
        "for i, w in enumerate(weights_m5):\n",
        "    count = (labels_3cls == i).sum()\n",
        "    print(f'  Class {i}: n={count}  weight={w:.3f}')\n",
        "\n",
        "\n",
        "# ─── Focal Loss (handles hard examples + imbalance better than plain CE) ──\n",
        "class FocalLoss(nn.Module):\n",
        "    \"\"\"\n",
        "    FIX 2 BONUS: Focal loss down-weights easy correct predictions,\n",
        "    forcing the model to focus on hard/rare examples (Mild class).\n",
        "    alpha = per-class weight (same as class_weight in CrossEntropyLoss)\n",
        "    gamma = focusing parameter (2.0 is standard)\n",
        "    \"\"\"\n",
        "    def __init__(self, alpha=None, gamma=2.0, label_smoothing=0.1):\n",
        "        super().__init__()\n",
        "        self.alpha           = alpha   # [num_classes] tensor\n",
        "        self.gamma           = gamma\n",
        "        self.label_smoothing = label_smoothing\n",
        "\n",
        "    def forward(self, logits, targets):\n",
        "        num_classes = logits.size(1)\n",
        "        # Label smoothing\n",
        "        if self.label_smoothing > 0:\n",
        "            smooth_targets = torch.full_like(\n",
        "                logits, self.label_smoothing / (num_classes - 1))\n",
        "            smooth_targets.scatter_(1, targets.unsqueeze(1),\n",
        "                                    1.0 - self.label_smoothing)\n",
        "        else:\n",
        "            smooth_targets = F.one_hot(targets, num_classes).float()\n",
        "\n",
        "        log_probs = F.log_softmax(logits, dim=1)\n",
        "        probs     = log_probs.exp()\n",
        "\n",
        "        # Focal weight: (1 - p_t)^gamma\n",
        "        p_t = (probs * F.one_hot(targets, num_classes)).sum(dim=1)  # [B]\n",
        "        focal_w = (1 - p_t) ** self.gamma                           # [B]\n",
        "\n",
        "        ce = -(smooth_targets * log_probs).sum(dim=1)               # [B]\n",
        "\n",
        "        if self.alpha is not None:\n",
        "            alpha_t = self.alpha[targets]\n",
        "            ce = alpha_t * ce\n",
        "\n",
        "        return (focal_w * ce).mean()\n",
        "\n",
        "\n",
        "ce_criterion   = nn.CrossEntropyLoss(weight=weights_m5, label_smoothing=0.1)\n",
        "focal_criterion = FocalLoss(alpha=weights_m5, gamma=2.0, label_smoothing=0.1)\n",
        "\n",
        "print('Criteria ready: CrossEntropyLoss + FocalLoss (both with class weights)')\n"
      ]
    },
