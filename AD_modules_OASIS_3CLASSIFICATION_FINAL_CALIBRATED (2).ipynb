      "source": [
        "## Module 7 — Output and Visualization Module\n",
        "This was the main gap flagged in the HLD coverage review — no Grad-CAM or\n",
        "attention heatmaps existed. This section adds both, using the model's\n",
        "*already-trained* weights (no retraining needed):\n",
        "\n",
        "- **Grad-CAM 3D** on the last conv block of the Module 3 shared encoder,\n",
        "  showing which brain voxels most influenced the classification score.\n",
        "- **Attention heatmap** extracted directly from the Module 4b Swin\n",
        "  cross-attention weights (fine hippocampal windows attending to coarse\n",
        "  whole-brain windows), showing where the transformer's global context\n",
        "  is focusing.\n",
        "- A combined **diagnostic report** per patient: predicted stage +\n",
        "  confidence + both overlays + probability bar chart — matching the HLD\n",
        "  Step 7 output (\"Predicted disease stage\" + \"Attention maps highlighting\n",
        "  important brain regions\")."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "zmBYmhRjLwWJ",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "7949fd06-a6f4-4971-a31e-a0a0841e6c1b"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Module 7a ready — Grad-CAM hooked to shared_encoder.block3 (last conv block of the Module 3 backbone, 96 channels @ 16x16x16)\n"
          ]
        }
      ],
      "source": [
        "# ═══════════════════════════════════════════════════════════════════════\n",
        "# MODULE 7a — Grad-CAM (Gradient-weighted Class Activation Mapping)\n",
        "# ═══════════════════════════════════════════════════════════════════════\n",
        "\n",
        "class GradCAM3D:\n",
        "    \"\"\"\n",
        "    Hooks the last conv block of the Module 3 shared encoder and backs out\n",
        "    a voxel-level heatmap of which regions drove the predicted class.\n",
        "    \"\"\"\n",
        "    def __init__(self, model, target_layer):\n",
        "        self.model = model\n",
        "        self.activations = None\n",
        "        self.gradients = None\n",
        "        target_layer.register_forward_hook(self._save_activation)\n",
        "        target_layer.register_full_backward_hook(self._save_gradient)\n",
        "\n",
        "    def _save_activation(self, module, inp, out):\n",
        "        self.activations = out\n",
        "\n",
        "    def _save_gradient(self, module, grad_in, grad_out):\n",
        "        self.gradients = grad_out[0]\n",
        "\n",
        "    def generate(self, mri, hippo, tabular, target_class=None):\n",
        "        self.model.eval()\n",
        "        mri = mri.clone().to(device).requires_grad_(True)\n",
        "        hippo = hippo.to(device)\n",
        "        tabular = tabular.to(device)\n",
        "\n",
        "        fused, seg_logits, cls_logits = self.model(mri, hippo, tabular)\n",
        "        cls_logits = torch.nan_to_num(cls_logits)\n",
        "        if target_class is None:\n",
        "            target_class = cls_logits.argmax(dim=1)\n",
        "        target_class = target_class.to(device)\n",
        "\n",
        "        self.model.zero_grad()\n",
        "        score = cls_logits.gather(1, target_class.view(-1, 1)).sum()\n",
        "        score.backward()\n",
        "\n",
        "        weights = self.gradients.mean(dim=(2, 3, 4), keepdim=True)            # [B,C,1,1,1]\n",
        "        cam = F.relu((weights * self.activations).sum(dim=1, keepdim=True))   # [B,1,d,h,w]\n",
        "        cam = F.interpolate(cam, size=mri.shape[2:], mode='trilinear', align_corners=False)\n",
        "        cam = cam.squeeze(1).detach().cpu().numpy()\n",
        "\n",
        "        for i in range(cam.shape[0]):\n",
        "            c = cam[i]\n",
        "            cmin, cmax = c.min(), c.max()\n",
        "            cam[i] = (c - cmin) / (cmax - cmin + 1e-8)\n",
        "\n",
        "        probs = F.softmax(cls_logits / T_final, dim=1).detach().cpu().numpy()   # temperature-scaled\n",
        "        return cam, target_class.cpu().numpy(), probs\n",
        "\n",
        "\n",
        "grad_cam = GradCAM3D(model, model.shared_encoder.block3)\n",
        "print('Module 7a ready — Grad-CAM hooked to shared_encoder.block3 '\n",
        "      '(last conv block of the Module 3 backbone, 96 channels @ 16x16x16)')\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "fWVxJ656Vd2a",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "627a546f-0efd-4654-8879-3279e0aa35cc"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Module 7b ready — attention heatmap extracted from Module 4b cross-attention\n"
          ]
        }
      ],
      "source": [
        "# ═══════════════════════════════════════════════════════════════════════\n",
        "# MODULE 7b — Attention Heatmap (from Module 4b Swin cross-attention)\n",
        "# ═══════════════════════════════════════════════════════════════════════\n",
        "\n",
        "def get_attention_heatmap(model, mri, hippo, tabular):\n",
        "    model.eval()\n",
        "    with torch.no_grad():\n",
        "        mri, hippo, tabular = mri.to(device), hippo.to(device), tabular.to(device)\n",
        "        x_in = torch.cat([mri, hippo], dim=1)          # match ADModel_M5.forward\n",
        "        shared_feat = model.shared_encoder(x_in)        # use x_in, not mri\n",
        "        swin = model.swin_transformer\n",
        "\n",
        "        B = shared_feat.size(0)\n",
        "\n",
        "        x = swin.proj(shared_feat)\n",
        "        fine_tokens, (_, nD, nH, nW) = swin.patch_fine(x)\n",
        "        for blk in swin.swin_fine:\n",
        "            fine_tokens = blk(fine_tokens)\n",
        "        fine_global = fine_tokens.mean(dim=1, keepdim=True).view(B, nD * nH * nW, -1)\n",
        "\n",
        "        coarse_tokens, (_, cD, cH, cW) = swin.patch_coarse(x)\n",
        "        for blk in swin.swin_coarse:\n",
        "            coarse_tokens = blk(coarse_tokens)\n",
        "        coarse_global = coarse_tokens.mean(dim=1).view(B, cD * cH * cW, -1)\n",
        "\n",
        "        _, attn_w = swin.cross_attn(fine_global, coarse_global, coarse_global,\n",
        "                                     need_weights=True, average_attn_weights=True)\n",
        "        # attn_w: [B, 64 fine windows, 8 coarse windows]\n",
        "        # salience = how strongly each fine (hippocampal-scale) window focuses\n",
        "        # on any single coarse (whole-brain-scale) window\n",
        "        salience = attn_w.max(dim=-1).values.view(B, nD, nH, nW)              # [B,4,4,4]\n",
        "        heatmap = F.interpolate(salience.unsqueeze(1), size=mri.shape[2:],\n",
        "                                 mode='trilinear', align_corners=False).squeeze(1)\n",
        "        heatmap = heatmap.cpu().numpy()\n",
        "\n",
        "    for i in range(heatmap.shape[0]):\n",
        "        h = heatmap[i]\n",
        "        hmin, hmax = h.min(), h.max()\n",
        "        heatmap[i] = (h - hmin) / (hmax - hmin + 1e-8)\n",
        "    return heatmap\n",
        "\n",
        "\n",
