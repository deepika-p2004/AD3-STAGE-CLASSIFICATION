      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "E1n-_6auVd2P",
        "outputId": "7a4a396d-ae10-4bef-b219-0643d3d9de2b"
      },
