      "source": [
        "# ═══════════════════════════════════════════════════════════════════════\n",
        "# MODULE 7c — Combined Diagnostic Report (HLD Step 7: Output & Interpretation)\n",
        "# ═══════════════════════════════════════════════════════════════════════\n",
        "\n",
        "def generate_diagnostic_report(sample_idx, dataset=full_dataset):\n",
        "    \"\"\"\n",
        "    Produces the final per-patient output: predicted disease stage +\n",
        "    confidence + Grad-CAM overlay + attention overlay + probability bars.\n",
        "    \"\"\"\n",
        "    mri, hippo, tabular, true_label = dataset[sample_idx]\n",
        "    mri_b = mri.unsqueeze(0)\n",
        "    tab_b = tabular.unsqueeze(0)\n",
        "\n",
        "    cam, pred_cls, probs = grad_cam.generate(mri_b, hippo.unsqueeze(0), tab_b)\n",
        "    attn_map = get_attention_heatmap(model, mri_b, hippo.unsqueeze(0), tab_b)\n",
        "\n",
        "    pred_label = int(pred_cls[0])\n",
        "    true_label = min(int(true_label), 2)\n",
        "    confidence = float(probs[0, pred_label])\n",
        "\n",
        "    mri_np = mri.squeeze(0).numpy()\n",
        "    mid = mri_np.shape[0] // 2\n",
        "    mri_slice = mri_np[mid]\n",
        "    cam_slice = cam[0, mid]\n",
        "    attn_slice = attn_map[0, mid]\n",
        "\n",
        "    fig, axes = plt.subplots(1, 4, figsize=(17, 4.5))\n",
        "    fig.suptitle(\n",
        "        f'Module 7 Diagnostic Report — Sample {sample_idx}   |   '\n",
        "        f'Predicted: {CLASS_NAMES[pred_label]}  (conf {confidence:.2f})   |   '\n",
        "        f'True: {CLASS_NAMES[true_label]}',\n",
        "        fontweight='bold', fontsize=11)\n",
        "\n",
        "    axes[0].imshow(mri_slice, cmap='gray')\n",
        "    axes[0].set_title('MRI (mid axial slice)')\n",
        "    axes[0].axis('off')\n",
        "\n",
        "    axes[1].imshow(mri_slice, cmap='gray')\n",
        "    axes[1].imshow(cam_slice, cmap='jet', alpha=0.45)\n",
        "    axes[1].set_title('Grad-CAM\\n(Module 3 backbone)')\n",
        "    axes[1].axis('off')\n",
        "\n",
        "    axes[2].imshow(mri_slice, cmap='gray')\n",
        "    axes[2].imshow(attn_slice, cmap='jet', alpha=0.45)\n",
        "    axes[2].set_title('Attention Heatmap\\n(Module 4b Swin)')\n",
        "    axes[2].axis('off')\n",
        "\n",
        "    bar_colors = ['#4CAF50', '#FF9800', '#F44336']\n",
        "    axes[3].bar(list(CLASS_NAMES.values()), probs[0], color=bar_colors)\n",
        "    axes[3].set_ylim(0, 1)\n",
        "    axes[3].set_title('Class Probabilities')\n",
        "    axes[3].tick_params(axis='x', rotation=30)\n",
        "    for i, p in enumerate(probs[0]):\n",
        "        axes[3].text(i, p + 0.02, f'{p:.2f}', ha='center', fontsize=8)\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "    print(f'Predicted disease stage : {CLASS_NAMES[pred_label]}')\n",
        "    print(f'Confidence              : {confidence:.1%}')\n",
        "    print(f'Ground truth             : {CLASS_NAMES[true_label]}')\n",
        "    return {'pred_label': pred_label, 'true_label': true_label,\n",
        "            'confidence': confidence, 'probs': probs[0]}\n",
        "\n",
        "\n",
        "# Show only the single highest-confidence diagnostic report\n",
        "best_row_pos = results_scaled['confidence'].idxmax()\n",
        "best_idx = best_fold_val_idx[best_row_pos]\n",
        "print(f'Highest-confidence sample: dataset index {best_idx}  '\n",
        "      f'(confidence = {results_scaled.loc[best_row_pos, \"confidence\"]:.3f})')\n",
        "\n",
        "generate_diagnostic_report(best_idx)\n"
      ]
