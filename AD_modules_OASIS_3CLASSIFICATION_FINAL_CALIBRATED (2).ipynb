      ],
      "source": [
        "# ─── FIX 3: Freeze all except classifier + tab_encoder ─────────────────\n",
        "# Using the ORIGINAL MSD-pretrained weights here (not the OASIS fine-tune) --\n",
        "# these are the exact weights the BOX_L/BOX_R localization was validated with.\n",
        "# Masks are already precomputed and stored in full_dataset.hippos at this point,\n",
        "# so seg_model's weights from here on don't affect classifier training at all --\n",
        "# this load is just to keep seg_model in a known, consistent state.\n",
        "seg_model.load_state_dict(\n",
        "    torch.load('/content/hippocampus_unet.pth', map_location=device))\n",
        "seg_model.eval()\n",
        "for p in seg_model.parameters():\n",
        "    p.requires_grad = False\n",
        "print('seg_model frozen')\n",
        "\n",
        "for p in model.parameters():\n",
        "    p.requires_grad = True\n",
        "\n",
        "trainable = sum(p.numel() for p in model.parameters() if p.requires_grad)\n",
        "total_p   = sum(p.numel() for p in model.parameters())\n",
        "print(f'Trainable params: {trainable:,} / {total_p:,}  ({100*trainable/total_p:.1f}%)')\n",
        "\n",
        "\n",
        "# ─── FIX 5: TorchIO augmentation pipeline ───────────────────────────────\n",
        "augment = tio.Compose([\n",
        "    tio.RandomFlip(axes=(0, 1, 2), p=0.5),\n",
        "    tio.RandomAffine(scales=0.1, degrees=10, p=0.5),\n",
        "    tio.RandomNoise(std=0.05, p=0.3),\n",
        "    tio.RandomBlur(std=0.5, p=0.2),\n",
        "])\n",
        "\n",
        "def augment_batch(mri_batch):\n",
        "    \"\"\"FIX 5: Apply TorchIO augmentation per sample. Expects [B, 1, D, H, W].\"\"\"\n",
        "    augmented = []\n",
        "    for m in mri_batch:\n",
        "        tio_img = tio.ScalarImage(tensor=m.cpu())\n",
        "        augmented.append(augment(tio_img).data)\n",
        "    return torch.stack(augmented)\n",
        "\n",
        "print('TorchIO augmentation pipeline ready (Flip + Affine + Noise + Blur)')\n"
      ]
    },
