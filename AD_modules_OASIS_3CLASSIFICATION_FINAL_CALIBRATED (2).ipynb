    {
      "cell_type": "markdown",
      "metadata": {
        "id": "qtXp0fhaVd2R"
      },
      "source": [
        "## Module 2 — OASIS Preprocessing"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "0vJ_HglKLwV1"
      },
      "outputs": [],
      "source": [
        "# ─── Localized hippocampus segmentation ──────────────────────────────────\n",
        "# BOX_L / BOX_R were found empirically: a sliding-window search using the\n",
        "# ORIGINAL MSD-pretrained seg_model weights, scored by total foreground\n",
        "# probability, restricted to windows that are >=60% real brain tissue\n",
        "# (to reject degenerate all-background windows). Both boxes were then\n",
        "# visually confirmed to reproduce at a consistent relative anatomical\n",
        "# location across multiple subjects (OAS1_0001-0004) in the same T88\n",
        "# atlas-registered space. This is a fixed, DATASET-WIDE crop -- it only\n",
        "# works because every OASIS T88 scan shares the same 176x208x176 grid.\n",
        "BOX_SIZE = (40, 56, 40)\n",
        "BOX_L    = (18, 48, 26)\n",
        "BOX_R    = (114, 40, 26)\n",
        "\n",
        "\n",
        "def load_mri_and_bbox(path, target_size=(64,64,64)):\n",
        "    \"\"\"\n",
        "    Loads a scan, returns:\n",
        "      mri        - z-scored, cropped-to-nonzero, resized-to-target_size tensor\n",
        "                   (same as the original load_mri -- used as ADModel_M5 input)\n",
        "      img_raw    - the RAW (un-normalized) full volume, needed so the fixed\n",
        "                   BOX_L/BOX_R windows can be cropped at native resolution\n",
        "      bbox       - the nonzero crop bounds (x0,x1,y0,y1,z0,z1) applied to\n",
        "                   img_raw to get `mri` -- reused so the hippocampus mask\n",
        "                   is cropped/resized identically and stays spatially\n",
        "                   aligned with `mri`\n",
        "    \"\"\"\n",
        "    img = nib.load(path).get_fdata()\n",
        "    if img.ndim == 4: img = img[...,0]\n",
        "    nz = np.nonzero(img)\n",
        "    if len(nz[0]) > 0:\n",
        "        x0, x1 = nz[0].min(), nz[0].max()+1\n",
        "        y0, y1 = nz[1].min(), nz[1].max()+1\n",
        "        z0, z1 = nz[2].min(), nz[2].max()+1\n",
        "    else:\n",
        "        x0,x1,y0,y1,z0,z1 = 0,img.shape[0],0,img.shape[1],0,img.shape[2]\n",
        "\n",
        "    img_cropped = img[x0:x1, y0:y1, z0:z1]\n",
        "    img_norm    = (img_cropped - img_cropped.mean()) / (img_cropped.std() + 1e-8)\n",
        "    img_norm    = np.nan_to_num(img_norm)\n",
        "    t = torch.tensor(img_norm, dtype=torch.float32).unsqueeze(0).unsqueeze(0)\n",
        "    t = F.interpolate(t, size=target_size, mode='trilinear', align_corners=False)\n",
        "    return t.squeeze(0), img, (x0,x1,y0,y1,z0,z1)\n",
        "\n",
        "\n",
        "def segment_hippocampus_localized(img_raw, bbox, target_size=(64,64,64)):\n",
        "    \"\"\"\n",
        "    Runs seg_model on the two FIXED (left/right) native-resolution windows\n",
        "    (matching MSD's ~40x56x40 training scale), places each prediction back\n",
        "    into full-brain-volume space, then applies the SAME nonzero-crop +\n",
        "    resize as load_mri_and_bbox used for the MRI channel -- so the mask\n",
        "    stays voxel-aligned with `mri` in the final 64^3 space.\n",
        "    \"\"\"\n",
        "    full_mask = np.zeros_like(img_raw, dtype=np.float32)\n",
        "    valid = img_raw[img_raw != 0]\n",
        "    brain_mean = valid.mean() if len(valid) else 0.0\n",
        "    brain_std  = valid.std() + 1e-8 if len(valid) else 1.0\n",
        "\n",
        "    for (x0, y0, z0) in [BOX_L, BOX_R]:\n",
        "        wx, wy, wz = BOX_SIZE\n",
        "        patch = img_raw[x0:x0+wx, y0:y0+wy, z0:z0+wz]\n",
        "        if patch.shape != (wx, wy, wz):\n",
        "            continue\n",
        "        patch_norm = (patch - brain_mean) / brain_std\n",
        "        patch_norm[patch == 0] = 0\n",
        "        t = torch.tensor(patch_norm, dtype=torch.float32).unsqueeze(0).unsqueeze(0)\n",
        "        t_resized = F.interpolate(t, size=target_size, mode='trilinear', align_corners=False).to(device)\n",
        "        with torch.no_grad():\n",
        "            pred = torch.argmax(seg_model(t_resized), dim=1).squeeze(0).cpu().numpy()\n",
        "        pred_bin = (pred > 0).astype(np.float32)\n",
        "        pred_t = torch.tensor(pred_bin).unsqueeze(0).unsqueeze(0)\n",
        "        pred_native = F.interpolate(pred_t, size=(wx, wy, wz), mode='nearest').squeeze().numpy()\n",
        "        full_mask[x0:x0+wx, y0:y0+wy, z0:z0+wz] = np.maximum(\n",
        "            full_mask[x0:x0+wx, y0:y0+wy, z0:z0+wz], pred_native)\n",
        "\n",
        "    bx0, bx1, by0, by1, bz0, bz1 = bbox\n",
        "    mask_cropped = full_mask[bx0:bx1, by0:by1, bz0:bz1]\n",
        "    mt = torch.tensor(mask_cropped, dtype=torch.float32).unsqueeze(0).unsqueeze(0)\n",
        "    mt = F.interpolate(mt, size=target_size, mode='nearest')\n",
        "    return mt.squeeze(0)\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "vZCPp-lBLwV1"
      },
      "outputs": [],
      "source": [
        "import glob\n",
        "class OASISDataset(Dataset):\n",
        "    def __init__(self, root_dirs):\n",
        "        if isinstance(root_dirs, str):\n",
        "            root_dirs = [root_dirs]\n",
        "\n",
        "        paths_and_labels = []\n",
        "        for root_dir in root_dirs:\n",
        "            for subject in sorted(os.listdir(root_dir)):\n",
        "                label = get_label(subject)\n",
        "                if label is None: continue\n",
        "                # Use ONLY the atlas-registered, skull-stripped T88 file --\n",
        "                # avoids picking up SUBJ_111 (native space) or the\n",
        "                # non-masked T88 gfc file, which would mix different\n",
        "                # coordinate spaces / preprocessing under one label.\n",
        "                t88_dir = os.path.join(root_dir, subject, 'PROCESSED', 'MPRAGE', 'T88_111')\n",
        "                # Filename encodes acquisition count (n1, n2, n3, n4...) which\n",
        "                # varies per subject -- glob for any count, don't hardcode n4.\n",
        "                matches = sorted(glob.glob(os.path.join(\n",
        "                    t88_dir, f'{subject}_mpr_n*_anon_111_t88_masked_gfc.img')))\n",
        "                if matches:\n",
        "                    paths_and_labels.append((matches[0], label, subject))\n",
        "\n",
        "        print(f'Found {len(paths_and_labels)} scans across {len(root_dirs)} disc(s) '\n",
        "              f'(T88 atlas-registered, skull-stripped only). Pre-computing masks...')\n",
        "        self.mris=[]; self.hippos=[]; self.labels=[]; self.tabular=[]\n",
        "\n",
        "        # --- Extract and z-score normalise tabular features ---\n",
        "        TAB_COLS = ['Age', 'Educ', 'SES', 'MMSE', 'eTIV', 'nWBV', 'ASF']\n",
        "        tab_raw = []\n",
        "        for path, label, subject in paths_and_labels:\n",
        "            row = df_oasis[df_oasis['ID'] == subject]\n",
        "            feats = []\n",
        "            for col in TAB_COLS:\n",
        "                if len(row) > 0 and col in row.columns:\n",
        "                    val = row[col].values[0]\n",
        "                    feats.append(float(val) if not pd.isna(val) else 0.0)\n",
        "                else:\n",
        "                    feats.append(0.0)\n",
        "            tab_raw.append(feats)\n",
        "        tab_arr = np.array(tab_raw, dtype=np.float32)\n",
        "        tab_mean = tab_arr.mean(axis=0)\n",
        "        tab_std  = tab_arr.std(axis=0) + 1e-8\n",
        "        tab_norm = (tab_arr - tab_mean) / tab_std\n",
        "\n",
        "        for i, (path, label, subject) in enumerate(paths_and_labels):\n",
        "            mri, img_raw, bbox = load_mri_and_bbox(path)\n",
        "            mask = segment_hippocampus_localized(img_raw, bbox)\n",
        "            self.mris.append(mri)\n",
        "            self.hippos.append(mri * mask)\n",
        "            self.labels.append(label)\n",
        "            self.tabular.append(torch.tensor(tab_norm[i], dtype=torch.float32))\n",
        "            if (i+1) % 10 == 0 or (i+1) == len(paths_and_labels):\n",
        "                print(f'  {i+1}/{len(paths_and_labels)}', end='\\r')\n",
        "        print()\n",
        "        counts = Counter(self.labels)\n",
        "        print(f'OASIS ready: {len(self.labels)} samples')\n",
        "        for k, v in sorted(counts.items()):\n",
        "            print(f'  Class {k} - {CLASS_NAMES[k]}: {v} samples')\n",
        "\n",
        "    def __len__(self): return len(self.mris)\n",
        "\n",
        "    def __getitem__(self, i):\n",
        "        return self.mris[i], self.hippos[i], self.tabular[i], \\\n",
        "               torch.tensor(self.labels[i], dtype=torch.long)\n"
      ]
    },
